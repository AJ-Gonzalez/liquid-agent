{
  "name": "liquid-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "description": "A private AI agent for macOS and Linux that runs LFM3 1.7B and LFM3 Omni 2B locally, with a web UI.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "start": "node server/index.js --open",
    "serve": "node server/index.js",
    "dev": "vite build --watch --mode development & node --watch-path=server server/index.js",
    "app": "npm run build && electron electron/main.mjs",
    "app:package": "npm run build && node scripts/package.mjs",
    "themes:check": "node scripts/themes.mjs",
    "typecheck": "tsc --noEmit -p web",
    "test": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "electron": "^45.1.0",
    "katex": "0.16.11",
    "lucide-react": "0.453.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "rehype-highlight": "7.0.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.0",
    "remark-math": "6.0.0",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "zustand": "4.5.5"
  }
}
